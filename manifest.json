{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "ChatLog",
  "version": "2.0.1",
  "description": "Bitácora para quien quiere usar modelos de lenguaje de IA con ética y transparencia",
  "permissions": [
    "storage",
    "sidePanel",
    "downloads"
  ],
  "action": {
    "default_title": "Abrir ChatLog",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "minimum_chrome_version": "116"
}
